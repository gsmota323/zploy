# =============================================================
# Zploy — Template de variáveis de ambiente
# =============================================================
# INSTRUÇÕES:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha os valores marcados com <CHANGE_ME>
#   3. NUNCA versione o arquivo .env nem .env.* no Git
#
# Dois modos de operação:
#   • Modo Plataforma: AUTH_ENABLED=true  (login/registro habilitado)
#   • Modo Local:      AUTH_ENABLED=false (sem autenticação, usuário automático)
# =============================================================

# ------------------------------------------------------------
# Servidor
# ------------------------------------------------------------
PORT=3000

# Número de "hops" de reverse proxy confiáveis, para X-Forwarded-* e rate limiting por IP.
# Deixe vazio/ausente no Zploy Local (sem proxy na frente) — padrão seguro, não confia em nenhum proxy.
# No Zploy Platform, defina a quantidade de proxies/load balancers na frente da aplicação (ex.: 1).
TRUST_PROXY_HOPS=

# ------------------------------------------------------------
# Autenticação
# ------------------------------------------------------------
# true  → modo plataforma (login/registro obrigatório)
# false → modo local (sem autenticação)
AUTH_ENABLED=false

# Chave secreta para assinar tokens JWT
# Gere um valor forte: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<CHANGE_ME>

# Chave usada para criptografar (AES-256-GCM) os valores das variáveis de ambiente das apps em repouso.
# NUNCA reutilize o JWT_SECRET aqui. Deve ser uma chave base64 de 32 bytes (256 bits).
# Gere um valor: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Ausência ou formato inválido faz a aplicação recusar salvar/ler variáveis de ambiente (não há fallback em plaintext).
ENV_ENCRYPTION_KEY=<CHANGE_ME>

# ------------------------------------------------------------
# Banco de dados (PostgreSQL)
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:<CHANGE_ME>@localhost:5432/tcc_db

# ------------------------------------------------------------
# Fila (Redis / BullMQ)
# ------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ------------------------------------------------------------
# Webhook do GitHub
# ------------------------------------------------------------
# Secret configurado no webhook do repositório GitHub
# Deixar vazio desativa completamente o webhook (todos os POSTs retornam 401)
# Gere: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
GITHUB_WEBHOOK_SECRET=<CHANGE_ME>

# ------------------------------------------------------------
# Frontend (CORS)
# ------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------
# Modo Local — usuário local automático (AUTH_ENABLED=false)
# ------------------------------------------------------------
LOCAL_DEV_EMAIL=study@zploy.local
LOCAL_DEV_USERNAME=study
LOCAL_DEV_PASSWORD=<CHANGE_ME>