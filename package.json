    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "prisma": {
    "seed": "ts-node-dev prisma/seed.ts"
  }
