  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "worker": "ts-node-dev --respawn --transpile-only src/workers/deployWorker.ts",
    "up": "npm run start",
    "up:k8s": "npm run start:k8s",
    "up:demo": "npm run demo:up",
    "down": "node scripts/stop.js",
    "down:k8s": "node scripts/stop.js --k8s",
    "down:demo": "node scripts/stop.js --demo",
    "start": "node scripts/start.js",
    "start:k8s": "node scripts/start-k8s.js",
    "k8s:expose": "node scripts/k8s-expose.js",
    "demo:up": "docker compose -f docker-compose.yml -f docker-compose.demo.yml up --build -d",
    "demo:down": "docker compose -f docker-compose.yml -f docker-compose.demo.yml stop",
    "demo:clean": "docker compose -f docker-compose.yml -f docker-compose.demo.yml down",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
